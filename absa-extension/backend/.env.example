# These are process environment variables; .env is not loaded automatically.
# Defaults find the existing repository resources. No model weights are copied.
ABSA_DEVICE=auto
ABSA_BATCH_SIZE=16
ABSA_MAX_REVIEWS=100
ABSA_MAX_REVIEW_CHARS=4000
ABSA_MAX_TOTAL_CHARS=150000
ABSA_TORCH_THREADS=4
# Public deployment: use a private key file and explicit trusted hosts.
# ABSA_API_KEY_FILE=/run/secrets/api_key
# ABSA_ALLOWED_HOSTS=localhost,127.0.0.1,api,*.trycloudflare.com
# ABSA_CHECKPOINT=C:/path/to/best_model_birnn_cleanser_focal_loss_VI.pt
# ABSA_MODEL_NAME=vinai/phobert-base
# VNCORENLP_DIR=C:/path/to/vncorenlp_model
# JAVA_EXECUTABLE=java
