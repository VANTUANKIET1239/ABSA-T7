et/shop/f2cf02cb2dc94b1d036f1d9c78fec978.png\" /\u003e\u003cspan\u003e\u003c/span\u003e\u003cimg src=\"https://vn-test-11.slatic.net/shop/7f5728b143f40fb3ee9db250c2b50e07.png\" /\u003e\u003cspan\u003e\u003c/span\u003e\u003c/p\u003e\u003c/article\u003e",
                                           "highlights":  "\u003carticle class=\"lzd-article\"\u003e\u003cul style=\"list-style-type: disc;\"\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eC\u0026Ocirc;NG DỤNG:\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eL\u0026agrave;m sạch s\u0026acirc;u c\u0026aacute;c chất dơ từ lỗ ch\u0026acirc;n l\u0026ocirc;ng, \u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eCải thiện t\u0026igrave;nh trạng ra dầu cho da, \u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eC\u0026acirc;n bằng độ pH cho da,hỗ trợ t\u0026aacute;i tạo tế b\u0026agrave;o da, \u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eHạn chế dầu nhờn v\u0026agrave; mụn\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eL\u0026agrave;m dịu v\u0026agrave; phục hồi da nhạy cảm, h\u0026igrave;nh th\u0026agrave;nh h\u0026agrave;ng r\u0026agrave;o bảo vệ tr\u0026ecirc;n da \u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eGiảm t\u0026aacute;c động của hoạt động bề mặt trong qu\u0026aacute; tr\u0026igrave;nh l\u0026agrave;m sạch ngăn ngừa tổn thương da.\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eGi\u0026agrave;u vitamin ngăn ngừa t\u0026agrave;n nhang v\u0026agrave; l\u0026agrave;m s\u0026aacute;ng da\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003echo l\u0026agrave;n da tr\u0026agrave;n trắng s\u0026aacute;ng tr\u0026agrave;n đầy năng lượng, sức sống.\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eGi\u0026uacute;p loại bỏ c\u0026aacute;c th\u0026agrave;nh phần oxy h\u0026oacute;a c\u0026oacute; hại cho da \u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eL\u0026agrave;m sạch v\u0026agrave; dưỡng ẩm da một c\u0026aacute;ch hiệu quả\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eCấp ẩm cho l\u0026agrave;n da, gi\u0026uacute;p se kh\u0026iacute;t lỗ ch\u0026acirc;n l\u0026ocirc;ng\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eHƯỚNG DẪN SỬ DỤNG\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eBước 1. Rửa mặt bằng nước.\r\n\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eBước 2. Lấy một lượng nhỏ sửa rửa mặt\u0026nbsp;cho v\u0026agrave;o l\u0026ograve;ng b\u0026agrave;n\u0026nbsp;tay v\u0026agrave; tạo bọt\r\n\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eBước 3. Massage mặt khoảng 1 - 3 ph\u0026uacute;t theo chiều xo\u0026aacute;y\u0026nbsp;ốc\r\n\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eBước 4. Rửa sạch mặt bằng nước m\u0026aacute;t v\u0026agrave; lao bằng khăn mềm.\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eLƯU \u0026Yacute;:\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eBảo quản nhiệt độ tho\u0026aacute;ng mắt\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cdiv style=\"line-height: 1.7;text-align: left;text-indent: 0;\"\u003e\u003cspan\u003eTr\u0026aacute;nh b\u0026ocirc;i l\u0026ecirc;n mắt v\u0026agrave; vết thương hở\u003c/span\u003e\u003c/div\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\"line-height: 1.7;text-align: left;text-indent: 0;margin-left: 0;margin-top: 0;margin-bottom: 0;\"\u003e\u003cspan\u003e\u003c/span\u003e\u003c/p\u003e\u003c/article\u003e",
