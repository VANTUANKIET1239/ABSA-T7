			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "BERTopic: baseline",
			"type": "shell",
			"command": "${workspaceFolder}/.venv-bertopic/Scripts/python.exe",
			"args": [
				"-u", "-B", "-X", "utf8",
