				"--single-run",
				"--output-dir", "${workspaceFolder}/topic-modeling/data/bertopic_unique_baseline"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"OMP_NUM_THREADS": "4", "MKL_NUM_THREADS": "4"}
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "BERTopic: grid search",
